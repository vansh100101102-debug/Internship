{
  "name": "zetawa-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend": "cd auth-backend && npm run server",
    "backend:start": "cd auth-backend && npm start",
    "frontend": "cd zetawa-main && npm run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run backend:start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "multer": "^2.4.0"
  }
}
